        "/api/facilities/{facility}/review": {
            "post": {
                "tags": [
                    "Review"
                ],
                "summary": "施設のレビュー投稿",
                "operationId": "PostFacilityReview",
                "parameters": [
                    {
                        "name": "facility",
                        "in": "path",
                        "description": "施設ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "comment",
                                    "rating"
                                ],
                                "properties": {
                                    "comment": {
                                        "type": "string",
                                        "example": "とても綺麗でした"
                                    },
                                    "rating": {
                                        "type": "integer",
                                        "example": 5
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "レビュー投稿成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "レビューを投稿しました。"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/profile": {
            "get": {
                "tags": [
                    "User"
                ],
                "summary": "現在のユーザー自身",
                "description": "現在のユーザー自身の取得",
                "operationId": "myProfile",
                "responses": {
                    "200": {
                        "description": "ユーザー取得成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "$ref": "#/components/schemas/User"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Address": {
                "title": "Addressモデル",
                "description": "町域の情報",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "municipality_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "postal_code": {
                        "type": "string",
                        "example": "1234567"
                    },
                    "town": {
                        "type": "string",
                        "example": "",
                        "nullable": true
                    },
                    "chome": {
                        "type": "string",
                        "nullable": true
                    },
                    "banchi": {
                        "type": "string",
                        "nullable": true
                    },
                    "go": {
                        "type": "string",
                        "nullable": true
                    },
                    "building": {
                        "type": "string",
                        "nullable": true
                    },
                    "room": {
                        "type": "string",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    }
                },
                "type": "object"
            },
            "AddressWithRelations": {
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Address"
                    },
                    {
                        "properties": {
                            "municipality": {
                                "$ref": "#/components/schemas/MunicipalityWithPrefecture"
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "Event": {
                "title": "Eventモデル",
                "description": "Event情報",
                "required": [
                    "id",
                    "facility_id",
                    "title",
                    "start_datetime",
                    "end_datetime"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "facility_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "読み聞かせ会"
                    },
                    "start_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    },
                    "end_datetime": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    },
                    "capacity": {
                        "type": "integer",
                        "example": 20
                    },
                    "deleted_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": null,
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    }
                },
                "type": "object"
            },
            "Facility": {
                "title": "Facilityモデル",
                "description": "施設情報",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "北区役所"
                    },
                    "image": {
                        "type": "string",
                        "example": "",
                        "nullable": true
                    },
                    "latitude": {
                        "type": "number",
                        "format": "float",
                        "example": 35.6895
                    },
                    "longitude": {
                        "type": "number",
                        "format": "float",
                        "example": 139.6917
                    },
                    "equipment": {
                        "type": "string",
                        "example": "設備情報です。"
                    },
                    "description": {
                        "type": "string",
                        "example": "設備情報です。"
                    },
                    "address_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-09-14T00:00:00Z"
                    }
                },
                "type": "object"
            },
            "FacilityWithRelations": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/Facility"
                    },
                    {
                        "properties": {
                            "address": {
                                "$ref": "#/components/schemas/AddressWithRelations"
                            },
                            "reviews": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/FacilityReviewWithUser"
                                }
                            },
                            "phone": {
                                "$ref": "#/components/schemas/Telphone"
                            },
                            "hours": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/FacilityHour"
                                }
                            },
                            "events": {
                                "type": "array",
                                "items": {
                                    "$ref": "#/components/schemas/Event"
                                }
                            }
                        },
                        "type": "object"
                    }
                ]
            },
            "FacilityHour": {
                "title": "FacilityHourモデル",
                "description": "営業日時の情報",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "day_of_week": {
                        "type": "integer",
                        "example": 1
                    },
                    "day_of_week_label": {
                        "description": "曜日名（日本語）",
                        "type": "string",
                        "example": "月曜日"
                    },
                    "open_time": {
                        "description": "開始時刻",
                        "type": "string",
                        "format": "time",
                        "example": "09:00"
                    },
                    "close_time": {
                        "description": "終了時刻",
                        "type": "string",
                        "format": "time",
                        "example": "18:00"
                    },
                    "note": {
                        "type": "string",
                        "example": "備考"
                    }
                },
                "type": "object"
            },
            "FacilityReview": {
                "title": "FacilityReviewモデル",
                "description": "施設の口コミ情報",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "facility_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "user_id": {
                        "type": "integer",
                        "example": 2
                    },
                    "rating": {
                        "type": "integer",
                        "example": 3
                    },
                    "comment": {
                        "type": "string",
                        "example": "施設の感想です。",
                        "nullable": true
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-24T11:08:53Z"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2025-10-24T11:08:53Z"
                    }
                },
                "type": "object"
            },
            "FacilityReviewWithUser": {
                "type": "object",
                "allOf": [
                    {
                        "$ref": "#/components/schemas/FacilityReview"
                    },
