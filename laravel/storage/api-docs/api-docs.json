        "/api/facilities": {
            "get": {
                "tags": [
                    "Facility"
                ],
                "summary": "施設一覧",
                "description": "施設一覧の取得",
                "operationId": "FacilitiesInfo",
                "parameters": [
                    {
                        "name": "name",
                        "in": "query",
                        "description": "施設名での検索キーワード",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "example": "北区"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "施設一覧取得成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "facilities": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/FacilityWithRelations"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/facilities/{id}": {
            "get": {
                "tags": [
                    "Facility"
                ],
                "summary": "施設詳細",
                "description": "施設詳細の取得",
                "operationId": "FacilityInfo",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "施設ID",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "施設詳細取得成功",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "required": [
                                        "facility",
                                        "isFavorite"
                                    ],
                                    "properties": {
                                        "facility": {
                                            "$ref": "#/components/schemas/FacilityWithRelations"
                                        },
                                        "isFavorite": {
                                            "description": "ログインユーザーがお気に入りしているか",
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "施設が見つからない場合",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "該当の施設が見つかりません。"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
